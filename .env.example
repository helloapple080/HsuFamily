# PORTAL_DOMAIN 與 API_DOMAIN 必須同屬一個可註冊網域，以符合 SameSite=Strict Cookie。
PORTAL_DOMAIN=portal.example.com
API_DOMAIN=api.example.com
FAMILY_PORTAL_SUBNET=172.20.0.0/24
CADDY_PROXY_IP=172.20.0.10
# MONGO_ROOT_PASSWORD 不受 URI 限制，因為 compose 以 argv 傳遞此密碼。
MONGO_ROOT_PASSWORD=replace-with-secret-manager-value
# MONGO_APP_PASSWORD 會嵌入 MongoDB URI，僅允許 URI-unreserved ASCII [A-Za-z0-9._~-]，建議至少 32 個隨機字元；禁止 @:/?#% 等 reserved 字元。
MONGO_APP_PASSWORD=replace-with-32-plus-random-uri-safe-characters
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-one-time-bootstrap-password
# Google Drive 媒體儲存預設停用；啟用時四個 OAuth/folder 值必須由 secret manager 注入。
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Tunnel 模式請將 API_DOMAIN 設成與 PORTAL_DOMAIN 相同，供基礎 Compose 設定插值。
# CLOUDFLARE_TUNNEL_TOKEN=
# TUNNEL_EDGE_SUBNET=172.29.53.0/24
# TUNNEL_CONNECTOR_IP=172.29.53.3
